<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Welcome to Hemacue</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f7f7f7;
        color: #333;
      }
      .container {
        max-width: 500px;
        margin: 40px auto;
        background: #fff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      }
      .footer {
        margin-top: 30px;
        font-size: 12px;
        color: #888;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h2>Welcome to Hemacue, <%= name %>!</h2>
      <p>
        Thank you for registering on Hemacue - Blood Donation & Emergency Assistance Platform.
      </p>
      <p>
        Your account has been successfully verified. You are ready to save lives and request emergency blood assistance.
      </p>
      <div class="footer">
        &copy; Hemacue Platform. All rights reserved.
      </div>
    </div>
  </body>
</html>
